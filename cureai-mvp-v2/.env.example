# Public browser-safe Supabase project values (never put service keys here)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key used by the mobile-number sign-in lookup route.
# Keep it only in .env.local / deployment secrets. Never use NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=
